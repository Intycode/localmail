{
	"$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
	"productName": "LocalMail",
	"version": "../package.json",
	"identifier": "dev.mail.client",
	"build": {
		"beforeDevCommand": "bun --cwd apps/client dev",
		"devUrl": "http://localhost:4321",
		"beforeBuildCommand": "bun --cwd apps/client build",
		"frontendDist": "../apps/client/dist"
	},
	"app": {
		"windows": [
			{
				"title": "LocalMail",
				"width": 1100,
				"height": 720,
				"minWidth": 720,
				"minHeight": 520,
				"resizable": true,
				"decorations": false,
				"transparent": true
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"externalBin": ["binaries/mail-engine"],
		"windows": {
			"certificateThumbprint": "6D1F281F5D7BC0432ABDDD9B426103441FB7AC33",
			"digestAlgorithm": "sha256",
			"timestampUrl": "http://timestamp.sectigo.com",
			"tsp": true
		},
		"category": "Productivity",
		"shortDescription": "Client email locale-first e privacy-first",
		"longDescription": "Mail — client email minimale e veloce. Local-first, privacy-first: niente cloud, niente account, niente tracking. La posta resta sul tuo dispositivo (SQLite cifrato), le password nel keychain di sistema.",
		"publisher": "Intycode Sagl",
		"homepage": "https://github.com/Intycode/localmail"
	}
}
